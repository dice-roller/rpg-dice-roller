{
  "name": "@dice-roller/rpg-dice-roller",
  "description": "An advanced JS based dice roller that can roll various types of dice and modifiers, along with mathematical equations.",
  "author": "GreenImp Media <info@greenimp.co.uk> (https://greenimp.co.uk)",
  "version": "5.5.0",
  "license": "MIT",
  "type": "module",
  "main": "./dist/esm/bundle.js",
  "module": "./dist/esm/bundle.js",
  "browser": "./dist/umd/bundle.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/esm/bundle.js"
      },
      "require": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/umd/bundle.js"
      }
    },
    "./dist/umd/bundle.js": {
      "types": "./dist/types/index.d.ts",
      "require": "./dist/umd/bundle.js"
    },
    "./types/": "./dist/types/",
    "./package.json": "./package.json"
  },
  "types": "./dist/types/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/dice-roller/rpg-dice-roller.git"
  },
  "bugs": {
    "url": "https://github.com/dice-roller/rpg-dice-roller/issues"
  },
  "homepage": "https://dice-roller.github.io/documentation",
  "funding": [
    "https://github.com/sponsors/dice-roller",
    "https://github.com/sponsors/GreenImp"
  ],
  "keywords": [
    "dice",
    "roller",
    "rpg",
    "roll",
    "d&d",
    "dnd",
    "random",
    "prng",
    "roleplay",
    "pathfinder",
    "notation"
  ],
  "devDependencies": {
    "@babel/core": "^7.26.9",
    "@babel/preset-env": "^7.26.9",
    "@babel/preset-typescript": "^7.26.0",
    "@eslint/js": "^9.20.0",
    "@rollup/plugin-babel": "^5.3.1",
    "@rollup/plugin-node-resolve": "^14.1.0",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.2",
    "@types/jest": "^29.5.14",
    "abab": "^2.0.6",
    "eslint": "^9.20.0",
    "eslint-plugin-jest": "^28.11.0",
    "jest": "^29.1.2",
    "peggy": "^3.0.2",
    "pure-rand": "^7.0.1",
    "rollup": "^2.79.1",
    "rollup-plugin-license": "^3.6.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "ts-pegjs": "^4.2.1",
    "typescript": "^4.8.4",
    "typescript-eslint": "^8.24.0",
    "vuepress-jsdoc": "^5.0.0"
  },
  "dependencies": {
    "mathjs": "^14.2.0"
  },
  "engines": {
    "node": ">=20.0"
  },
  "scripts": {
    "build": "npm run build:dev && npm run build:prod && npm run build:definitions",
    "build:prepare": "npm run build:grammars && npm run lint",
    "build:definitions": "rm -rf ./dist/types/ && tsc -p definitions.tsconfig.json",
    "build:dev": "npm run build:prepare && rollup --c --environment BUILD:dev",
    "build:grammars": "peggy -c ./peggy.config.cjs src/Parser/grammars/grammar.pegjs -o src/Parser/grammars/grammar.ts",
    "build:prod": "npm run build:prepare && rollup --c --environment BUILD:prod",
    "docs:build": "vuepress-jsdoc --dist ./docs --folder api --exclude=\"index.[jt]s,**/index.[jt]s,**/parser/grammars/*\" --partials=\"./docs/partials/**/*.hbs\" --readme=\"./docs/readme.md\"",
    "docs:watch": "npm run docs:build -- --watch",
    "watch": "npm run build:dev -- -w",
    "lint": "eslint src/** tests/**",
    "lint:fix": "eslint --fix src/** tests/**",
    "pretest": "npm run build:prepare",
    "test": "jest",
    "test:coverage": "npm test -- --coverage",
    "test:watch": "npm test -- --watchAll",
    "prepublishOnly": "npm test && npm run build"
  }
}
