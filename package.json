{
  "name": "@dice-roller/rpg-dice-roller",
  "description": "An advanced JS based dice roller that can roll various types of dice and modifiers, along with mathematical equations.",
  "author": "GreenImp Media <info@greenimp.co.uk> (https://greenimp.co.uk)",
  "version": "5.5.0",
  "license": "MIT",
  "type": "module",
  "main": "./dist/esm/bundle.js",
  "module": "./dist/esm/bundle.js",
  "browser": "./dist/umd/bundle.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/esm/bundle.js"
      },
      "require": {
        "types": "./dist/types/index.d.cts",
        "default": "./dist/umd/bundle.js"
      }
    },
    "./dist/umd/bundle.js": {
      "types": "./dist/types/index.d.cts",
      "require": "./dist/umd/bundle.js"
    },
    "./src/": "./src/",
    "./types/": "./dist/types/",
    "./package.json": "./package.json"
  },
  "types": "./dist/types/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/dice-roller/rpg-dice-roller.git"
  },
  "bugs": {
    "url": "https://github.com/dice-roller/rpg-dice-roller/issues"
  },
  "homepage": "https://dice-roller.github.io/documentation",
  "funding": [
    "https://github.com/sponsors/dice-roller",
    "https://github.com/sponsors/GreenImp"
  ],
  "keywords": [
    "dice",
    "roller",
    "rpg",
    "roll",
    "d&d",
    "dnd",
    "random",
    "prng",
    "roleplay",
    "pathfinder",
    "notation"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "@rollup/plugin-typescript": "^12.3.1",
    "@types/jest": "^30.0.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "peggy": "^5.1.1",
    "prettier": "^3.9.10",
    "rollup": "^4.66.0",
    "rollup-plugin-license": "^3.7.1",
    "ts-jest": "^29.4.15",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vuepress-jsdoc": "^5.0.0"
  },
  "dependencies": {
    "mathjs": "^15.2.0",
    "random-js": "^2.1.0"
  },
  "engines": {
    "node": ">=22"
  },
  "//typescript": "TypeScript is pinned to 6.0.x because ts-jest (<7) and typescript-eslint (<6.1) do not support TypeScript 7 yet.",
  "scripts": {
    "build": "npm run build:dev && npm run build:prod && npm run build:definitions",
    "build:prepare": "npm run build:grammars && npm run typecheck && npm run lint",
    "build:definitions": "rm -rf dist/types/ && npm run build:grammars && tsc -p definitions.tsconfig.json && cp ./dist/types/index.d.ts ./dist/types/index.d.cts",
    "build:dev": "npm run build:prepare && rollup -c --environment BUILD:dev",
    "build:grammars": "peggy -c ./peggy.config.cjs",
    "build:prod": "npm run build:prepare && rollup -c --environment BUILD:prod",
    "docs:build": "vuepress-jsdoc --dist ./docs --folder api --exclude=\"index.js,**/index.js,**/parser/generated/*,**/types/**/*\" --partials=\"./docs/partials/**/*.hbs\" --readme=\"./docs/readme.md\"",
    "docs:watch": "npm run docs:build -- --watch",
    "watch": "npm run build:dev -- -w",
    "format": "prettier --write .",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint --fix . && prettier --write .",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build:prepare",
    "test": "jest",
    "test:coverage": "npm test -- --coverage",
    "test:watch": "npm test -- --watchAll",
    "prepublishOnly": "npm test && npm run build"
  }
}
